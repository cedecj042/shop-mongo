<%- include('../includes/head.ejs') %>
<link rel="stylesheet" href="/css/form.css">
</head>

<body>
  <%- include('../includes/navigation.ejs') %>
  <main>
    <form action="/admin/<% if(editing) { %>users/edit <% } else { %>users/create<%} %>" method="POST" class="product-form">
      <h1 style="margin-bottom: 0;"><% if(editing) { %> Edit <% } else { %> Add  <%} %> Product Form</h1>

      <div class="form-control">
        <label for="title">Product Name</label>
        <input type="text" placeholder="Product Name" name="title" value="<%= editing ? product.title : '' %>"/>
      </div>
      <div class="form-control">
        <label for="title">Product Description</label>
        <textarea type="text" placeholder="Enter product description" name="description" id="description" rows="5"><%= editing ? product.description : '' %></textarea>
      </div>
      <div class="form-control">
        <label for="title">Price</label>
        <input type="number" placeholder="0.00" name="price"  value="<%= editing ? product.price : '' %>"/>
      </div>
      <div class="form-control">
        <label for="imageUrl">Image URL</label>
        <input type="text" placeholder="Enter url" name="imageUrl" id="imageUrl"  value="<%= editing ? product.imageUrl : '' %>"/>
      </div>
      <button type="submit"><% if(editing) { %> Edit <% } else { %> Add  <%} %> Product</button>
      <% if (editing) {%> 
        <input hidden type="hidden" value="<%= product._id%>" name="productId"/>
      <%}%>
    </form>
  </main>
  <%- include('../includes/end.ejs') %>